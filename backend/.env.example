# Copy this file to .env (gitignored) and fill in real values.
# Never commit .env or put a real key directly in this file.

# Optional for /insights -- Claude is used when set, a local Ollama model
# otherwise. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional -- defaults to mongodb://localhost:27017 if unset.
# MONGODB_URI=mongodb://localhost:27017

# Recommended: without this, a random key is generated at each backend
# restart, which logs every session out. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# Optional -- defaults shown. Only used the first time the app starts
# (seeds the one customer account); has no effect after that.
# CUSTOMER_NAME=Your Name
# CUSTOMER_EMAIL=you@example.com

# Optional -- defaults shown.
# OLLAMA_MODEL=qwen2.5:3b-instruct
# OLLAMA_URL=http://localhost:11434
# JWT_EXPIRY_HOURS=168
